#!/bin/sh
# Before anything leaves this machine: the tree is free of internal names, and so is every
# commit being pushed (author, committer, message and diff).
# Installed by scripts/setup-git-identity.sh (core.hooksPath=.githooks).
set -eu

check="$(git rev-parse --show-toplevel)/scripts/check-no-internals.sh"
zero=0000000000000000000000000000000000000000
"${check}" --tree
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "${local_sha}" != "${zero}" ] || continue
  if [ "${remote_sha}" = "${zero}" ]; then
    # A new branch: check what no remote-tracking branch already has.
    "${check}" "--commits=${local_sha} --not --remotes"
  else
    "${check}" "--commits=${remote_sha}..${local_sha}"
  fi
done
